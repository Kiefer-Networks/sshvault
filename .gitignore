# ============================================================================
# SSHVault .gitignore
# ============================================================================

# --------------------------------------------------------------------------
# Local assistant/editor state
# --------------------------------------------------------------------------
.claude/
.codex/
.claude_memory/
.cursor/
.cursorignore
.cursorindexingignore
.cursorules
.copilot/
copilot-*.md
.tabnine/
.tabnine_root
.aider*
.continue/
.cody/
.sourcegraph/
.windsurf/
.supermaven/
.codium/
.devai/
.bolt/
.v0/
ai-*.log
*.ai.bak
CLAUDE.md
coding.md

# --------------------------------------------------------------------------
# Flutter / Dart
# --------------------------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Flutter apps, vendored packages and native platform subprojects.
build/
coverage/
*.dart.js
*.dart.js.deps
*.dart.js.map
*.dart.precompiled.js
# Keep pubspec.lock versioned: this is an application, not a package.
# Keep generated Dart/localization sources and plugin registrants versioned.
# They are required by the existing clean-checkout build and CI workflow.

# --------------------------------------------------------------------------
# Go Backend
# --------------------------------------------------------------------------
server/sshvault-server
server/bin/
server/vendor/
server/*.exe
server/*.exe~
server/*.dll
server/*.so
server/*.dylib
server/*.test
server/*.out
server/coverage.txt
server/coverage.html

# --------------------------------------------------------------------------
# IDE & Editors
# --------------------------------------------------------------------------
*.iml
*.ipr
*.iws
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
\#*\#
.#*

# --------------------------------------------------------------------------
# OS generated files
# --------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
desktop.ini
Thumbs.db:encryptable
ehthumbs_vista.db
$RECYCLE.BIN/
*.stackdump

# --------------------------------------------------------------------------
# Build & Compilation
# --------------------------------------------------------------------------
/linux/flutter/ephemeral/
/windows/flutter/ephemeral/
/macos/Flutter/ephemeral/
*.class
*.o
*.obj
*.a
*.lib
*.exp
*.dll
*.so
*.dylib
*.exe
*.out
*.pdb
*.ilk
*.idb
*.ipch
*.dmp
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja
.ninja_deps
.ninja_log

# Local installers/release artifacts; do not ignore all ZIPs (test fixtures).
/installer-output/
/artifacts/
/*.zip
*.apk
*.apks
*.aab
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.dmg
*.flatpak

# --------------------------------------------------------------------------
# Logs & Temp
# --------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.pid
*.seed
/tmp/
/temp/
/test-results/
__pycache__/
.pytest_cache/
.venv/
venv/

# --------------------------------------------------------------------------
# Security — never commit secrets
# --------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
!**/test/fixtures/*.pem
.env
.env.*
!.env.example
secrets/
credentials.json

# --------------------------------------------------------------------------
# Symbolication & Obfuscation (Flutter)
# --------------------------------------------------------------------------
app.*.symbols
app.*.map.json

# --------------------------------------------------------------------------
# Android
# --------------------------------------------------------------------------
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
.android/
/android/local.properties
/android/key.properties

# --------------------------------------------------------------------------
# Windows / Visual Studio (including projects opened from the repo root)
# --------------------------------------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
/windows/Debug/
/windows/Release/
/windows/x64/
/windows/x86/
/windows/ARM64/
/windows/Generated Files/
/windows/AppPackages/
/windows/BundleArtifacts/

# --------------------------------------------------------------------------
# iOS / macOS
# --------------------------------------------------------------------------
**/Pods/
**/Podfile.lock
*.xcuserdata/
**/xcuserdata/
**/DerivedData/

# --------------------------------------------------------------------------
# Web
# --------------------------------------------------------------------------
/web/.dart_tool/

# --------------------------------------------------------------------------
# Docker (server)
# --------------------------------------------------------------------------
server/docker/data/
server/*.db
server/*.db-journal
server/*.db-wal
server/*.db-shm

# --------------------------------------------------------------------------
